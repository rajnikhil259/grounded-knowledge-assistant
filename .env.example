# Copy this file to backend/.env and fill in your key. NEVER commit the real .env.
GEMINI_API_KEY=paste_your_key_here

# Models (change here if Google renames/retires one - no code change needed)
LLM_MODEL=gemini-3.1-flash-lite
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# Database (host port 5433 so it never clashes with a local Postgres on 5432)
DATABASE_URL=postgresql://rag:rag@localhost:5433/ragdb

# RAG settings
CHUNK_SIZE=800
TOP_K=4
MIN_SIMILARITY=0.40

# Price used only to ESTIMATE cost (USD per 1M tokens)
PRICE_INPUT_PER_M=0.25
PRICE_OUTPUT_PER_M=1.50
